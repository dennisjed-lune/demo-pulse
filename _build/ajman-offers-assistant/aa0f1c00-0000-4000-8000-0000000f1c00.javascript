    hi: { search: "ऑफ़र खोजें या असिस्टेंट से पूछें", askLune: "असिस्टेंट से पूछें", fxChatPh: "अपने ऑफ़र या कैशबैक के बारे में पूछें", lifetime: "उपलब्ध बैलेंस · कभी समाप्त नहीं", fxBalanceSub: "इसमें अगस्त में कमाए {m} शामिल हैं। {p} अभी बाकी है।", fxHeroLabel: "अगस्त में कमाया कैशबैक · {p} बाकी", footCash: "खरीद की पुष्टि होने पर कैशबैक आपके रिवॉर्ड बैलेंस में जुड़ता है: स्टोर में 3 दिन में, ऑनलाइन रिटर्न अवधि के बाद। आपका बैलेंस कभी समाप्त नहीं होता।", footPts: "खरीद की पुष्टि होने पर पॉइंट आपके बैलेंस में जुड़ते हैं: स्टोर में 3 दिन में, ऑनलाइन रिटर्न अवधि के बाद।", clears: "मर्चेंट की पुष्टि पर जुड़ेगा", transferPoints: "पार्टनर ट्रांसफ़र", cardsNote: "एक बार ऑफ़र चालू करें, यह इन सभी कार्ड पर चलेगा, सप्लीमेंटरी कार्ड पर भी। कार्ड रजिस्टर करने की ज़रूरत नहीं।", card1: "%DEBIT%", card2: "%CREDIT%", card1m: "आपका ज़्यादातर कैशबैक इसी कार्ड से आता है", step1Store: "नीचे ऑफ़र चालू करें। यह आपके Ajman Bank कार्ड पर चलेगा, कोई कोड नहीं।", step2Store: "इनसे भुगतान करें: %DEBIT% ···· 4417 या %CREDIT% ···· 9102{at}। Apple Pay और Google Pay भी चलेंगे।", step2Both: "स्टोर में इनसे भुगतान करें: %DEBIT% ···· 4417 या %CREDIT% ···· 9102। ऑनलाइन, अभी खरीदें दबाएँ और वहीं ऑर्डर पूरा करें। दोनों गिने जाएँगे।", step2Online: "उसी सेशन में ऑर्डर पूरा करें और अपने Ajman Bank कार्ड से भुगतान करें।", step1Online: "{brand} खोलने के लिए अभी खरीदें दबाएँ। ऑर्डर आपसे जुड़ जाएगा, कोई कोड नहीं।", trackedStore: "%DEBIT% ···· 4417 और %CREDIT% ···· 9102", trackedOnline: "अभी खरीदें लिंक · कोई भी Ajman Bank कार्ड", activeTitleStore: "आपके Ajman Bank कार्ड पर चालू", activeSubStore: "हमेशा की तरह ···· 4417 या ···· 9102 से भुगतान करें", activeSubOnline: "खुली हुई विंडो में भुगतान पूरा करें", onlineNote: "आपके बैंकिंग ऐप से स्टोर खोलता है", fu_howitworks: "एक बार ऑफ़र चालू करें, यह आपके डेबिट और क्रेडिट कार्ड पर चलेगा, ओमर के सप्लीमेंटरी कार्ड पर भी। स्टोर में कार्ड से जुड़ता है; ऑनलाइन, अभी खरीदें दबाने पर।", how2: "स्टोर में इनसे भुगतान करें: %DEBIT% ···· 4417 या %CREDIT% ···· 9102। ऑनलाइन, अभी खरीदें दबाएँ और खुली विंडो में ऑर्डर पूरा करें। Apple Pay और Google Pay भी चलेंगे।", how3: "कैशबैक पहले बाकी दिखता है, मर्चेंट की पुष्टि के बाद बैलेंस में आ जाता है।", howWorks: "Ajman Bank ऑफ़र कैसे काम करते हैं", turnOff: "बंद करें", fxConfirmTitle: "{name} को {get} भेजें?", fxConfirmSub: "आपके बैलेंस से {v} कटेंगे। पार्टनर ट्रांसफ़र वापस नहीं होते।", fxCancel: "रद्द करें", fxConfirmBtn: "ट्रांसफ़र की पुष्टि करें", fxBalanceReply: "आपके पास खर्च या ट्रांसफ़र के लिए {bal} हैं, जिसमें अगस्त में कमाए {m} शामिल हैं। आपके noon ऑर्डर के {p} अभी बाकी हैं।", watching: "आपके ऑफ़र और कैशबैक", fxRewardsName: "Ajman Bank रिवॉर्ड्स" },
    ur: { search: "آفرز تلاش کریں یا اسسٹنٹ سے پوچھیں", askLune: "اسسٹنٹ سے پوچھیں", fxChatPh: "اپنی آفرز یا کیش بیک کے بارے میں پوچھیں", lifetime: "دستیاب بیلنس · کبھی ختم نہیں ہوتا", fxBalanceSub: "اس میں اگست میں کمائے گئے {m} شامل ہیں۔ {p} ابھی زیرِ عمل ہیں۔", fxHeroLabel: "اگست میں کمایا گیا کیش بیک · {p} زیرِ عمل", footCash: "خریداری کی تصدیق پر کیش بیک آپ کے ریوارڈ بیلنس میں شامل ہوتا ہے: اسٹور میں 3 دن میں، آن لائن واپسی کی مدت کے بعد۔ آپ کا بیلنس کبھی ختم نہیں ہوتا۔", footPts: "خریداری کی تصدیق پر پوائنٹس آپ کے بیلنس میں شامل ہوتے ہیں: اسٹور میں 3 دن میں، آن لائن واپسی کی مدت کے بعد۔", clears: "مرچنٹ کی تصدیق پر شامل ہوگا", transferPoints: "پارٹنر ٹرانسفر", cardsNote: "آفر ایک بار فعال کریں، یہ ان تمام کارڈز پر چلے گی، اضافی کارڈز سمیت۔ کارڈ رجسٹر کرنے کی ضرورت نہیں۔", card1: "%DEBIT%", card2: "%CREDIT%", card1m: "آپ کا زیادہ تر کیش بیک اسی کارڈ سے آتا ہے", step1Store: "نیچے آفر فعال کریں۔ یہ آپ کے Ajman Bank کارڈز پر چلے گی، کوئی کوڈ نہیں۔", step2Store: "ان سے ادائیگی کریں: %DEBIT% ···· 4417 یا %CREDIT% ···· 9102{at}۔ Apple Pay اور Google Pay بھی شامل ہیں۔", step2Both: "اسٹور میں ان سے ادائیگی کریں: %DEBIT% ···· 4417 یا %CREDIT% ···· 9102۔ آن لائن، ابھی خریدیں دبائیں اور وہیں آرڈر مکمل کریں۔ دونوں شمار ہوں گے۔", step2Online: "اسی سیشن میں آرڈر مکمل کریں اور اپنے Ajman Bank کارڈ سے ادائیگی کریں۔", step1Online: "{brand} کھولنے کے لیے ابھی خریدیں دبائیں۔ آرڈر آپ سے منسلک ہو جائے گا، کوئی کوڈ نہیں۔", trackedStore: "%DEBIT% ···· 4417 اور %CREDIT% ···· 9102", trackedOnline: "ابھی خریدیں لنک · کوئی بھی Ajman Bank کارڈ", activeTitleStore: "آپ کے Ajman Bank کارڈز پر فعال", activeSubStore: "معمول کے مطابق ···· 4417 یا ···· 9102 سے ادائیگی کریں", activeSubOnline: "کھلی ہوئی ونڈو میں ادائیگی مکمل کریں", onlineNote: "آپ کی بینکنگ ایپ سے اسٹور کھولتا ہے", fu_howitworks: "آفر ایک بار فعال کریں، یہ آپ کے ڈیبٹ اور کریڈٹ کارڈز پر چلے گی، عمر کے اضافی کارڈ سمیت۔ اسٹور میں کارڈ سے، آن لائن ابھی خریدیں دبانے پر۔", how2: "اسٹور میں ان سے ادائیگی کریں: %DEBIT% ···· 4417 یا %CREDIT% ···· 9102۔ آن لائن، ابھی خریدیں دبائیں اور کھلنے والی ونڈو میں آرڈر مکمل کریں۔ Apple Pay اور Google Pay بھی شامل ہیں۔", how3: "کیش بیک پہلے زیرِ عمل دکھتا ہے، پھر مرچنٹ کی تصدیق پر بیلنس میں آ جاتا ہے۔", howWorks: "Ajman Bank کی آفرز کیسے کام کرتی ہیں", turnOff: "بند کریں", fxConfirmTitle: "{get} کو {name} بھیجیں؟", fxConfirmSub: "آپ کے بیلنس سے {v} کٹیں گے۔ پارٹنر ٹرانسفر واپس نہیں ہوتے۔", fxCancel: "منسوخ کریں", fxConfirmBtn: "ٹرانسفر کی تصدیق کریں", fxBalanceReply: "آپ کے پاس خرچ یا ٹرانسفر کے لیے {bal} ہیں، جن میں اگست میں کمائے گئے {m} شامل ہیں۔ آپ کے noon آرڈر کے {p} ابھی زیرِ عمل ہیں۔", watching: "آپ کی آفرز اور کیش بیک", fxRewardsName: "Ajman Bank ریوارڈز" },
    zh: { search: "搜索优惠，或问问助手", askLune: "问问助手", fxChatPh: "询问您的优惠或返现", lifetime: "可用余额 · 永不过期", fxBalanceSub: "其中 {m} 为八月所得，另有 {p} 待确认。", fxHeroLabel: "八月返现 · {p} 待确认", footCash: "交易确认后，返现会存入您的奖励余额：店内 3 天内，网购在退货期结束后。余额永不过期。", footPts: "交易确认后，积分会存入您的余额：店内 3 天内，网购在退货期结束后。", clears: "商户确认后到账", transferPoints: "转给合作伙伴", cardsNote: "优惠只需激活一次，即可用于以下所有卡，包括附属卡。无需登记卡片。", card1: "%DEBIT%", card2: "%CREDIT%", card1m: "您的大部分返现来自这张卡", step1Store: "在下方激活优惠。适用于您的 Ajman Bank 卡，无需记住任何代码。", step2Store: "使用以下卡付款：%DEBIT% ···· 4417 或 %CREDIT% ···· 9102{at}。Apple Pay 和 Google Pay 同样适用。", step2Both: "店内使用以下卡付款：%DEBIT% ···· 4417 或 %CREDIT% ···· 9102。网购请点“去购买”并在该页面完成订单。两种都算。", step2Online: "请在同一会话中完成订单，并使用您的 Ajman Bank 卡付款。", step1Online: "点“去购买”打开 {brand}。订单会自动关联到您，无需代码。", trackedStore: "%DEBIT% ···· 4417 和 %CREDIT% ···· 9102", trackedOnline: "“去购买”链接 · 任意 Ajman Bank 卡", activeTitleStore: "已在您的 Ajman Bank 卡上激活", activeSubStore: "照常使用 ···· 4417 或 ···· 9102 付款", activeSubOnline: "在已打开的窗口中完成付款", onlineNote: "从您的银行 App 打开商店", fu_howitworks: "优惠激活一次即可用于您的借记卡和信用卡，包括 Omar 的附属卡。店内按卡匹配；网购在点“去购买”后跟踪。", how2: "店内使用以下卡付款：%DEBIT% ···· 4417 或 %CREDIT% ···· 9102。网购请点“去购买”，在打开的窗口中完成订单。Apple Pay 和 Google Pay 同样适用。", how3: "返现先显示为待确认，商户确认后转入您的余额。", howWorks: "Ajman Bank 优惠如何运作", turnOff: "关闭", fxConfirmTitle: "将 {get} 转给 {name}？", fxConfirmSub: "将从您的余额扣除 {v}。合作伙伴转账无法撤回。", fxCancel: "取消", fxConfirmBtn: "确认转账", fxBalanceReply: "您有 {bal} 可用于消费或转账，其中 {m} 为八月所得。您 noon 订单的 {p} 仍待确认。", watching: "您的优惠和返现", fxRewardsName: "Ajman Bank 奖励" },
    ru: { search: "Найти предложение или спросить ассистента", askLune: "Спросить ассистента", fxChatPh: "Спросите о предложениях или кешбэке", lifetime: "Доступный баланс · не сгорает", fxBalanceSub: "Из них {m} получено в августе. Ещё {p} в обработке.", fxHeroLabel: "кешбэк за август · {p} в обработке", footCash: "Кешбэк зачисляется на бонусный баланс после подтверждения покупки: в магазине за 3 дня, онлайн после окончания срока возврата. Баланс не сгорает.", footPts: "Баллы зачисляются на баланс после подтверждения покупки: в магазине за 3 дня, онлайн после окончания срока возврата.", clears: "Зачислим после подтверждения продавцом", transferPoints: "Перевод партнёру", cardsNote: "Активируйте предложение один раз, и оно работает на всех этих картах, включая дополнительные. Регистрировать карту не нужно.", card1: "%DEBIT%", card2: "%CREDIT%", card1m: "Большая часть кешбэка приходит с этой карты", step1Store: "Активируйте предложение ниже. Оно работает на ваших картах Ajman Bank, без кодов.", step2Store: "Оплачивайте картой: %DEBIT% ···· 4417 или %CREDIT% ···· 9102{at}. Apple Pay и Google Pay тоже подходят.", step2Both: "В магазине оплачивайте картой: %DEBIT% ···· 4417 или %CREDIT% ···· 9102. Онлайн нажмите «Купить» и оформите заказ там. Засчитываются оба способа.", step2Online: "Оформите заказ в той же сессии и оплатите картой Ajman Bank.", step1Online: "Нажмите «Купить», чтобы открыть {brand}. Заказ привяжется к вам без кодов.", trackedStore: "%DEBIT% ···· 4417 и %CREDIT% ···· 9102", trackedOnline: "Ссылка «Купить» · любая карта Ajman Bank", activeTitleStore: "Активно на ваших картах Ajman Bank", activeSubStore: "Платите как обычно картой ···· 4417 или ···· 9102", activeSubOnline: "Завершите оплату в открывшемся окне", onlineNote: "Открывает магазин из вашего банковского приложения", fu_howitworks: "Активируйте предложение один раз, и оно работает на дебетовой и кредитной картах, включая дополнительную карту Омара. В магазине — по карте, онлайн — после нажатия «Купить».", how2: "В магазине оплачивайте картой: %DEBIT% ···· 4417 или %CREDIT% ···· 9102. Онлайн нажмите «Купить» и оформите заказ в открывшемся окне. Apple Pay и Google Pay тоже подходят.", how3: "Кешбэк сначала отображается как ожидающий, а после подтверждения продавцом переходит на баланс.", howWorks: "Как работают предложения Ajman Bank", turnOff: "Отключить", fxConfirmTitle: "Отправить {get} в {name}?", fxConfirmSub: "С баланса спишется {v}. Переводы партнёрам нельзя отменить.", fxCancel: "Отмена", fxConfirmBtn: "Подтвердить перевод", fxBalanceReply: "У вас {bal} для покупок или перевода, из них {m} получено в августе. {p} по заказу в noon ещё в обработке.", watching: "Ваши предложения и кешбэк", fxRewardsName: "Ajman Bank Бонусы" }
