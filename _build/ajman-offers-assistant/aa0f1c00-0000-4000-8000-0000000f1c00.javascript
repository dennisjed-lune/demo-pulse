if (window.BANK) {
  window.UI_FIX.en.fxBankName = window.BANK.en; window.UI_FIX.ar.fxBankName = window.BANK.ar || window.BANK.en;
  window.UI_FIX.en.fxRewardsName = window.BANK.en + " Rewards"; window.UI_FIX.ar.fxRewardsName = "مكافآت " + (window.BANK.ar || window.BANK.en);
}

// Arabic for English merchant strings that changed in the source
window.MERCHANT_L10N = window.MERCHANT_L10N || {};
Object.assign(window.MERCHANT_L10N.ar = window.MERCHANT_L10N.ar || {}, {
  "No card registration needed. Activate each offer once, then pay with any Ajman Bank card you hold, including supplementary cards.": "لا حاجة لتسجيل البطاقة. فعّلي كل عرض مرة واحدة، ثم ادفعي بأي بطاقة من مصرف عجمان لديكِ، بما فيها البطاقات الإضافية.",
  "Up to two orders today": "حتى طلبين اليوم"
});

// Keyboard and screen-reader access for clickable divs in the prototype
(function () {
  function bank(root) {
    if (!window.BANK || !root.querySelectorAll) return;
    root.querySelectorAll("img[data-bankmark]").forEach(function (img) { if (window.BANK.logo && img.getAttribute("src") !== window.BANK.logo) { img.setAttribute("src", window.BANK.logo); img.style.objectFit = "contain"; } });
    root.querySelectorAll("img[data-bankwater]").forEach(function (img) { img.style.display = "none"; });
  }
  function tag(root) {
    bank(root);
    (root.querySelectorAll ? root.querySelectorAll("[style*='cursor: pointer'], [style*='cursor:pointer']") : []).forEach(function (el) {
      if (el.tagName === "INPUT" || el.hasAttribute("role")) return;
      el.setAttribute("role", "button");
      el.setAttribute("tabindex", "0");
    });
    (root.querySelectorAll ? root.querySelectorAll("img[alt='']") : []).forEach(function (img) {
      var m = /logo_([a-z0-9]+)/.exec(img.getAttribute("src") || "");
      if (m) img.setAttribute("alt", m[1]);
    });
  }
  document.addEventListener("keydown", function (e) {
    var el = e.target;
    if ((e.key === "Enter" || e.key === " ") && el && el.getAttribute && el.getAttribute("role") === "button") { e.preventDefault(); el.click(); }
  });
  var mo = new MutationObserver(function () { tag(document); });
  function start() { tag(document); mo.observe(document.body, { childList: true, subtree: true }); }
  if (document.body) start(); else document.addEventListener("DOMContentLoaded", start);
  var st = document.createElement("style");
  st.textContent = "[role=button]:focus-visible{outline:2px solid var(--accent);outline-offset:2px}";
  (document.head || document.documentElement).appendChild(st);
})();
