// Category cover photos for offer cards (Unsplash, vetted: no visible brands). Keyed by offer id, so a country swap keeps a matching photo.
window.OFFER_COVERS = {"waitrose": "data:image/jpeg;base64,", "spinneys": "data:image/jpeg;base64,", "carrefour": "data:image/jpeg;base64,", "noon": "data:image/jpeg;base64,", "amazon": "data:image/jpeg;base64,", "justmop": "data:image/jpeg;base64,", "careem": "data:image/jpeg;base64,", "namshi": "data:image/jpeg;base64,", "talabat": "data:image/jpeg;base64,", "washmen": "data:image/jpeg;base64,", "vox": "data:image/jpeg;base64,", "shakeshack": "data:image/jpeg;base64,", "emirates": "data:image/jpeg;base64,", "ba": "data:image/jpeg;base64,", "wizz": "data:image/jpeg;base64,", "dishoom": "data:image/jpeg;base64,", "eataly": "data:image/jpeg;base64,", "grandbazaar": "data:image/jpeg;base64,", "sanlitun": "data:image/jpeg;base64,", "booking": "data:image/jpeg;base64,", "airbnb": "data:image/jpeg;base64,", "atlantis": "data:image/jpeg;base64,", "ritzrak": "data:image/jpeg;base64,", "kidzania": "data:image/jpeg;base64,", "olioli": "data:image/jpeg;base64,", "yas": "data:image/jpeg;base64,", "wbworld": "data:image/jpeg;base64,", "cocacolaarena": "data:image/jpeg;base64,", "platinumlist": "data:image/jpeg;base64,"};
// x-dc style bindings split on ";", so a data: URL ("jpeg;base64") breaks. Use blob: URLs instead.
(function () {
  var C = window.OFFER_COVERS, seen = {};
  Object.keys(C).forEach(function (k) {
    var d = C[k]; if (seen[d]) { C[k] = seen[d]; return; }
    try { var b = atob(d.split(",")[1]), a = new Uint8Array(b.length); for (var i = 0; i < b.length; i++) a[i] = b.charCodeAt(i);
      C[k] = seen[d] = URL.createObjectURL(new Blob([a], { type: "image/jpeg" })); } catch (e) { delete C[k]; }
  });
})();
